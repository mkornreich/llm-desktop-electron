# On-device model config for `local` provider mode.
# Used by run.sh when PROVIDER=local (./run-local.sh, or `PROVIDER=local ./run.sh`).
#
# `local` routes the agent's Claude Code sub-layer through the openai-proxy pointed at a local
# OpenAI-compatible server on THIS machine's GPU. The chat window is still remote claude.ai.
# KEY=VALUE format. No API key needed — the proxy treats a loopback OPENAI_BASE_URL as keyless.

# ---- model ----
# Must be pulled (`ollama pull <model>`) and emit proper OpenAI tool_calls — the agent is tool
# calls end to end. Good on this box, with native context windows:
#   qwen2.5:7b-instruct  (32K)    qwen3:8b (40K, adds a 'thinking' mode)    granite4.1:8b (128K)
# Avoid qwen2.5-coder:7b — it dumps tool calls as text. Pick one that fits VRAM (~5 GB for a
# 7-8B q4 model). granite4.1:8b's large native window suits the agent's big tool-heavy prompt.
OPENAI_MODEL=qwen2.5:7b-instruct

# OpenAI surface. chat = /v1/chat/completions (universal; caps tools at 128, which helps a small
# model). responses = /v1/responses (recent Ollama serves it; sends every tool).
OPENAI_API=chat

# ---- managed on-device Ollama ----
# When 1 (default), run.sh runs its OWN Ollama on OLLAMA_MANAGED_PORT with the context + tuning
# below, sharing any system Ollama's models. A system Ollama is usually pinned to a small context
# by its service unit and can't be rebound without root, so this leaves it untouched for its own
# clients and gives the agent a private, big-context instance. Set 0 to use OPENAI_BASE_URL
# as-is (you run and size the server yourself).
OLLAMA_AUTOSTART=1
OLLAMA_MANAGED_PORT=11435

# Context window (tokens) for the managed instance. The agent's prompt (system + up to 128
# tools) is large, so keep this generous. Default when a model has no per-model override below:
OLLAMA_CONTEXT_LENGTH=32768
# Per-model overrides — a bigger native window can take more; a large model needs less to fit
# VRAM. Exact model name after CONTEXT_:
CONTEXT_qwen2.5:7b-instruct=32768
CONTEXT_qwen3:8b=40960
CONTEXT_granite4.1:8b=65536
CONTEXT_gemma3:27b=8192

# GPU tuning for the managed instance (see `ollama serve --help`). These matter on a laptop GPU:
#   KV_CACHE_TYPE q8_0 roughly halves the context's VRAM vs f16 (requires flash attention);
#   FLASH_ATTENTION cuts memory further and speeds prompt processing;
#   NUM_PARALLEL 1 gives the FULL context to the single agent request instead of splitting it
#     across parallel slots (the default splits it — a silent context killer);
#   KEEP_ALIVE holds the model in VRAM between agent turns so it isn't reloaded each call.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m
# Models directory for the managed instance. Blank = the system Ollama's store if readable, else
# Ollama's default (~/.ollama/models). Set explicitly to override.
# OLLAMA_MODELS=/usr/share/ollama/.ollama/models

# Endpoint the proxy talks to. In autostart mode run.sh overrides this to the managed instance
# (http://127.0.0.1:${OLLAMA_MANAGED_PORT}/v1). Used directly only when OLLAMA_AUTOSTART=0.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# ---- Claude Code (agent) identity + context ----
# Internal identity handed to Claude Code; kept the same as openai mode so the CLI stays fully
# featured. What matters for a small local model is the compaction window below.
OPENAI_CLAUDE_CODE_MODEL=claude-opus-4-8[1m]
# Compact the conversation this many tokens in. Keep it under OLLAMA_CONTEXT_LENGTH, leaving room
# for the tools + reply.
CLAUDE_CODE_AUTO_COMPACT_WINDOW=24000
