# OpenRouter model config for `openrouter` provider mode.
# Used by run.sh when PROVIDER=openrouter (./run-openrouter.sh, or `PROVIDER=openrouter ./run.sh`).
#
# `openrouter` routes the agent's Claude Code sub-layer through the openai-proxy pointed at
# OpenRouter's OpenAI-compatible gateway (https://openrouter.ai/api/v1). The chat window is still
# remote claude.ai. KEY=VALUE format (same parser as .local-model / .provider).
#
# API KEY: this file does NOT hold the key. Put your OpenRouter key (sk-or-...) in .openai-key:
#     cp .openai-key.example .openai-key   # then set:  apiKey=sk-or-...
# .openai-key is gitignored; the proxy reads it as the keyfile source. A key is REQUIRED (a remote
# endpoint is never keyless, unlike local mode).

# ---- model ----
# Any OpenRouter model id that supports TOOL CALLING (the agent is tool calls end to end). The
# settings window's picker lists tool-capable models and flags the free ones. Notable FREE, tool-
# capable coders (Aug 2026): poolside/laguna-s-2.1:free, z-ai/glm-5.2:free, openai/gpt-oss-20b:free.
# Any paid model works too (higher rate limits). Browse: https://openrouter.ai/models
OPENAI_MODEL=poolside/laguna-s-2.1:free

# OpenAI surface. chat = /chat/completions (broadest model support; caps tools at 128 — the app
# sends ~93, so it fits). responses = /responses (stateless; OpenRouter supports it per-model and
# it sends every tool, avoiding the 128 cap). Leave as chat unless your model needs responses.
OPENAI_API=chat

# ---- free-tier notes ----
# Free (:free) models are limited to 20 requests/min and 50 requests/day (1000/day once you have
# >= $10 lifetime credit), and REQUIRE enabling data-sharing at https://openrouter.ai/settings/privacy
# or they return an error. An agentic coding loop burns many requests per task — expect 429s on the
# free tier; a small paid credit balance makes it usable.

# ---- Claude Code identity (required; do not remove) ----
# run.sh exports this so bundled Claude Code resolves a supported context window; it still sends
# claude-opus-4-8 on the wire, which the proxy maps to OPENAI_MODEL above.
OPENAI_CLAUDE_CODE_MODEL=claude-opus-4-8[1m]

# ---- optional: OpenRouter attribution headers ----
# Purely for OpenRouter's leaderboards/analytics (optional; no effect on functionality). Format is
# comma-separated Key:Value pairs. Uncomment to set:
# OPENAI_EXTRA_HEADERS=HTTP-Referer:https://github.com/mkornreich/llm-desktop-electron,X-Title:LLM Desktop
