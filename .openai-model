# OpenAI model config for this project (read by openai-proxy/proxy.mjs).
# The API key stays in ~/.dbeaver-ai-complete; only model choices live here.
# Precedence: OPENAI_MODEL env var > this file > ~/.dbeaver-ai-complete > default (gpt-4.1).

# Main coding model.
#
# gpt-5.6-sol, measured against gpt-5.3-codex on the identical 236-tool request this app
# actually sends, four samples each:
#
#   latency   codex 105.5s / 77.5s / 54.2s / 63.8s      sol 4.2s / 5.4s / 7.1s / 4.9s
#   context   codex 272k (253,339 ok, ~284k rejected)   sol >=622,229 accepted
#   effort    codex steps down to xhigh                 sol accepts max
#   tool call both correct, identical output tokens
#
# ~14x faster at the median with a >2x context window, which is also why the 173 logged
# context-overflow events should largely stop. Output QUALITY on real coding tasks is not
# measured — that is the one axis these numbers say nothing about.
OPENAI_MODEL=gpt-5.6-sol

# REQUIRED with a non-codex model, and not optional.
#
# The proxy's surface heuristic is "does the name contain codex", so gpt-5.6-sol would
# otherwise land on Chat Completions, where two things go wrong:
#   * the 128-tool cap bites — this app sends 236, so 108 get dropped
#   * with tools present the API refuses outright:
#       400 Function tools with reasoning_effort are not supported for gpt-5.6-sol
#           in /v1/chat/completions
# Forcing the Responses API gives all 236 tools and correct tool calls.
OPENAI_API=responses

# Fast model for Claude Code's auto-mode SAFETY CLASSIFIER — a separate, latency-
# sensitive LLM call made before each risky action. Routing it to a small fast
# model (instead of the slow codex model) avoids the "claude-opus-4-8 temporarily
# unavailable" fail-closed blocks. The proxy detects the classifier request by its
# system prompt and sends it to this model via Chat Completions.
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini

# Also request that model on the agent side. NOTE: the desktop builds the agent's
# env from a curated set, so this may not reach the in-app agent — the proxy-side
# routing above is the reliable mechanism; this is for the CLI agent / propagation.
CLAUDE_CODE_BG_CLASSIFIER_MODEL=gpt-4.1-mini

# Make the model picker list OpenAI models: with gateway model-discovery on, the
# app fetches GET <base>/v1/models and shows those ids. The proxy serves the list
# from OPENAI_PICKER_MODELS (default gpt-5.3-codex / gpt-5.4 / gpt-4.1 / -mini / 4o).
# Selecting one makes the agent request that id, which the proxy passes through.
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
# OPENAI_PICKER_MODELS=gpt-5.3-codex:GPT-5.3 Codex,gpt-4.1-mini:GPT-4.1 mini
# Output shaping for the remote claude.ai renderer (see openai-proxy/README.md):
# rewrites \(..\)/\[..\] math into $..$/$$..$$ and tells the model to write SVG to
# .svg files. Set to 0 to send the model's output through untouched.
OPENAI_OUTPUT_FIXUPS=1
# Agentic persistence: tells the model to finish the task rather than ending its turn to
# ask "shall I continue?". Auto mode grants permission to run tools but cannot make a
# model decide to keep going. Set to 0 to disable independently of OPENAI_OUTPUT_FIXUPS.
OPENAI_PERSISTENCE=1
# Auto-continue: when a turn ends with text that only ANNOUNCES an action and calls no
# tool, the proxy re-prompts the model and splices the result into the same assistant
# message, so the agent keeps going instead of waiting for "yes, continue". Never fires on
# confirmation requests for destructive actions, or for the safety classifier.
OPENAI_AUTO_CONTINUE=1
OPENAI_MAX_CONTINUATIONS=2
# Show the model's thinking. The Responses API only emits reasoning SUMMARIES, and only when
# BOTH summary and an explicit effort are sent — these become Anthropic `thinking` blocks.
# OPENAI_SHOW_THINKING=0 turns it off.
#
# OPENAI_REASONING_EFFORT is set to the API-wide maximum, `max`. Each model supports only a
# SUBSET of none|minimal|low|medium|high|xhigh|max and reports it only by rejecting the
# request, so the proxy walks the ladder down to the highest value the selected model
# accepts and caches it per model. For gpt-5.3-codex and gpt-5.4 that lands on `xhigh`.
# Effort buys deeper hidden reasoning, not longer visible summaries — and it is billed as
# output, so this costs real tokens and latency.
OPENAI_SHOW_THINKING=1
OPENAI_REASONING_EFFORT=max
# Output verbosity (github issue #1: "sometimes I see output with no text"). Native OpenAI
# knob text.verbosity — low|medium|high. gpt-5.3-codex is terse enough that tool-calling
# turns came back with zero characters of prose, so the UI showed a bare tool chip. Blank to
# omit the parameter entirely.
OPENAI_VERBOSITY=high
# Compaction (github issue #4). When the context window fills, old tool output is compacted.
# With OPENAI_COMPACT_SUMMARY=1 a cheap model condenses what is being dropped into a digest
# instead of discarding it — one extra call, and it falls back to plain truncation on any
# failure, so it can only add value. OPENAI_COMPACT_MODEL defaults to the classifier model.
OPENAI_COMPACT_SUMMARY=1
OPENAI_COMPACT_MODEL=gpt-4.1-mini
# Output-token handling (github issue #8).
# OPENAI_DEFAULT_MAX_TOKENS applies only when the client omits max_tokens. It used to be read
# from ~/.dbeaver-ai-complete, which sets maxTokens=512 for a SQL assistant — far too small for
# an agent, and with reasoning attached such a request could return nothing at all.
# OPENAI_CONTINUE_ON_TRUNCATION resumes a turn that the output cap cut off, appending to the
# same message. OPENAI_MAX_TURN_OUTPUT_TOKENS caps the total spliced into one message, staying
# under the client's own ceiling ("exceeded the 64000 output token maximum").
OPENAI_DEFAULT_MAX_TOKENS=8192
OPENAI_CONTINUE_ON_TRUNCATION=1
OPENAI_MAX_TURN_OUTPUT_TOKENS=56000

# Claude Code's INTERNAL model identity in OpenAI mode (issue #17). This is a client
# capability identity, not the model that answers the request. run.sh gives it only to the
# repository-owned disclaimer helper, which rewrites the exact bundled/cache Claude main-model
# argument without modifying Claude Code or the app bundle:
#
#   Claude Code init/session identity:  claude-opus-4-8[1m]
#   /v1/messages model after normalization: claude-opus-4-8
#   proxy-selected OpenAI model:         gpt-5.6-sol (OPENAI_MODEL above)
#
# `[1m]` is Claude Code's supported long-context suffix. Claude Code uses it while resolving
# its own capacity, then strips it before sending the Anthropic-compatible request. Do not put
# an OpenAI model id here: proxy-side model mapping happens too late to affect the client's
# context resolver. Anthropic mode does not export this setting and remains an exact passthrough.
OPENAI_CLAUDE_CODE_MODEL=claude-opus-4-8[1m]

# Upper bound for Claude Code's client-side context accounting (issues #14 and #17).
#
# This is NOT an unconditional context override. Bundled Claude Code 2.1.219 first resolves
# the capability of its internal model, then clamps this value to that capability. In the
# broken configuration the internal identity was unsuffixed claude-opus-4-8, the API base was
# localhost, no long-context beta was present, and localhost failed native first-party provider
# detection. That combination resolved to the 200,000-token fallback even though this value was
# 900,000. With a 20,000-token output reserve and the ordinary 13,000-token auto-compaction
# reserve, automatic compaction therefore clustered around 167,000 tokens:
#
#   200,000 - 20,000 - 13,000 = 167,000
#
# The supported `[1m]` identity above activates the 1M capability before this upper bound is
# applied. At 900,000, the UI has ~880,000 tokens available after the 20,000 output reserve,
# while ordinary automatic compaction begins around ~867,000 after the additional 13,000
# compaction reserve. Those are intentionally different figures. Reactive/precompute thresholds
# are separate again.
#
# The 900,000 upper bound comes from real /v1/responses probes whose input usage was reported by
# OpenAI:
#
#   gpt-5.6-sol    800,011 ok   900,011 ok   920,011 ok   |   930,000 REJECTED   950,000  1,000,000
#   gpt-5.3-codex  253,339 ok                             |   ~284,000 REJECTED
#   gpt-4.1        618,000 ok
#
# gpt-5.6-sol's measured ceiling is between 920,012 and 930,000. We use 900,000 rather than
# 920,000 because Claude Code reserves only 20,000 tokens while its maximum response is 64,000;
# the extra ~44,000 margin keeps a maximal answer below the known upstream ceiling. Change this
# whenever OPENAI_MODEL changes: the measurements are per-model and not interchangeable. Values
# below 100,000 are ignored and values above 1,000,000 are capped.
#
# Only exported in OpenAI mode. Real Anthropic mode keeps Claude's native context behavior.
# Proxy overflow compaction remains an independent fallback after an upstream context error; it
# is not the client-generated summary flow controlled by this setting.
CLAUDE_CODE_AUTO_COMPACT_WINDOW=900000
