# The OpenAI API key. Lives in its own app-folder file (openai-proxy/config.mjs reads
# `apiKey=` from it). A secret — never commit it. Copy .openai-key.example to start.
.openai-key

# Electron runtime — reinstall with `npm install` (also holds the
# Resources/app.asar symlink, which run.sh recreates on launch)
node_modules/

# Shadow Electron dist for the settings window: a hard-linked copy of the binary plus symlinks,
# with a clean resources/ (no app.asar) so `electron settings/` loads the settings app instead of
# Anthropic's bundle. Rebuilt on demand by settings/build-runtime.sh — never commit it.
settings/.electron-runtime/

# Isolated app profile — session/login data, not source
user-data/

# Runtime logs, including the rotated copies (proxy.log.1)
*.log
*.log.[0-9]

# Local backups of patched files (originals are preserved in git history)
*.orig

# macOS
.DS_Store
openai-proxy/tools-dump.txt
openai-proxy/usage.json
openai-proxy/usage.test-scratch.json
openai-proxy/tool-usage.json
openai-proxy/tool-usage.test-scratch.json
settings/server.log

# Which proxy process is running right now: pid, instance nonce, config hash. Per-machine
# runtime state, meaningless in another checkout, and committing it would let a stale record
# claim ownership of a pid on someone else's machine.
openai-proxy/proxy-runtime.json

# Temporary agent worktrees. Not source, and never to be committed.
.claude/worktrees/

# Per-session provenance: which model actually answered each session. Local runtime records
# about this machine's sessions, and they name session ids — not source, and not shareable.
provenance/
openai-proxy/websearch-debug.txt

# Session recordings (per-machine capture of your own agent session; may contain private content)
openai-proxy/session-recording.jsonl
docs/session-recording-transcript.md
