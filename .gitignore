# Electron runtime — reinstall with `npm install` (also holds the
# Resources/app.asar symlink, which run.sh recreates on launch)
node_modules/

# Isolated app profile — session/login data, not source
user-data/

# Runtime logs
*.log

# Local backups of patched files (originals are preserved in git history)
*.orig

# macOS
.DS_Store
openai-proxy/tools-dump.txt
openai-proxy/usage.json
settings/server.log
