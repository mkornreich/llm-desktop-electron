# Cohere model config for `cohere` provider mode.
# Used by run.sh when DEFAULT_PROVIDER=cohere (proxy mode: ./run-proxy.sh, or `PROVIDER=cohere ./run.sh`).
#
# `cohere` routes the agent's Claude Code sub-layer through the openai-proxy pointed at Cohere's
# OpenAI-compatible endpoint (https://api.cohere.ai/compatibility/v1). The chat window is still
# remote claude.ai. KEY=VALUE format (same parser as .local-model / .provider).
#
# API KEY: this file does NOT hold the key. Put your Cohere key in .openai-key:
#     cp .openai-key.example .openai-key   # then set:  apiKey=<your-cohere-key>
# .openai-key is gitignored; the proxy reads it as the keyfile source. A key is REQUIRED (a remote
# endpoint is never keyless, unlike local mode).

# ---- model ----
# Any Cohere model id that supports TOOL CALLING (the agent is tool calls end to end). Recommended:
#   command-a-03-2025        Command A — strong general tool use (the default)
#   command-a-plus-05-2026   newer, larger
#   command-r-plus-08-2024   older, cheaper
# Full list: https://docs.cohere.com/docs/models  (or GET /compatibility/v1/models with your key)
OPENAI_MODEL=command-a-03-2025

# OpenAI surface. Cohere's compatibility API is Chat Completions only (no /responses), so keep this
# as chat. chat caps tools at 128 — the app sends ~93, so it fits.
OPENAI_API=chat

# ---- endpoint (optional) ----
# Defaults to https://api.cohere.ai/compatibility/v1. Cohere also serves the same API at
# api.cohere.com; uncomment to switch hosts:
# OPENAI_BASE_URL=https://api.cohere.com/compatibility/v1

# ---- rate-limit notes ----
# Cohere TRIAL keys are rate-limited (roughly 20 requests/min plus a monthly cap) and are meant for
# evaluation — an agentic coding loop makes many requests per task, so expect 429s on a trial key.
# A production key (from the Cohere dashboard) raises the limits and makes it usable for real work.

# ---- Claude Code identity (required; do not remove) ----
# run.sh exports this so bundled Claude Code resolves a supported context window; it still sends
# claude-opus-4-8 on the wire, which the proxy maps to OPENAI_MODEL above.
OPENAI_CLAUDE_CODE_MODEL=claude-opus-4-8[1m]
