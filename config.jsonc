{
  // ============================================================================================
  //  llm_desktop — one config file for every mode, provider, endpoint, model, and tuning knob.
  //  JSONC: // and /* */ comments and trailing commas are allowed. Edit by hand or via Settings
  //  (the window preserves these comments). SECRETS ARE NOT HERE: API keys stay in .openai-key
  //  (gitignored). Any matching environment variable still overrides the value below.
  // ============================================================================================

  // Top-level mode. "proxy" translates Anthropic <-> a non-Anthropic backend; "anthropic" is a
  // pass-through to Anthropic's own API (every "providers"/tuning field below is then ignored).
  "mode": "proxy",

  // Which provider backs un-picked (main) turns, the classifier, and compaction. A Code-tab pick of
  // "<provider>:<model>" still routes that turn elsewhere.
  "defaultProvider": "freetoken",

  // Which on-device engine is active. The 8GB GPU holds only ONE at a time, so this is a toggle
  // (Settings > On-device engine): "freetoken" or "ollama". The selected engine is the one the launcher
  // autostarts, the one an on-device defaultProvider/classifier resolves to, and the only one whose
  // models appear in the Code-tab dropdown — the other's are hidden.
  "onDeviceEngine": "freetoken",

  // Per-provider endpoint + model. "endpoint" moved here from the hardcoded registry; blank falls back
  // to the built-in default. "ollama" is the keyless on-device Ollama (its endpoint is rediscovered at
  // launch when the managed server runs). "freetoken" is the keyless on-device FreeToken engine. Both
  // are loopback + have a "managed" block the launcher uses to autostart them. "ollama-cloud" is remote.
  "providers": {
    "openai": {
      "endpoint": "https://api.openai.com/v1",
      "api": "responses",
      "model": "gpt-5.6-sol",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "OpenAI",
      "keyNames": ["openaiApiKey","apiKey"],
      "isOpenAI": true,
      "responses": true
    },
    "ollama": {
      "endpoint": "http://127.0.0.1:11434/v1",
      "api": "responses",
      "model": "gemma4:latest",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      // managed on-device server. engine="ollama" is what the launcher (run.sh) and config.mjs use to
      // pick the ollama-specific bring-up (VRAM/context tuning, managedPort override of the base).
      "managed": { "engine": "ollama", "autostart": true, "managedPort": 11435, "keepAlive": "30m", "flashAttention": true, "kvCacheType": "q8_0", "numParallel": 1, "contextLength": 32768 },
      "context": { "qwen2.5:7b-instruct": 32768, "qwen3:8b": 40960, "granite4.1:8b": 65536, "gemma3:27b": 8192, "gemma4:latest": 131072 },
      "label": "Ollama",
      "keyNames": [],
      "isOpenAI": false,
      "responses": true,
      "loopback": true,
      // Port-scoped identity so providerForBase() can tell the managed port (11435) from FreeToken (1919),
      // on any loopback host. These providers are loopback-only, so matching the port is unambiguous.
      "match": ":(11434|11435)(/|$)"
    },
    "freetoken": {
      "endpoint": "http://127.0.0.1:1919/v1",
      "api": "chat",
      "model": "qwen3-1.7b",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      // FreeToken on-device engine (OpenAI-compatible, loopback). engine="freetoken" -> the generic
      // managed bring-up. modelPath is the HF weights dir (Qwen3 loads natively, no GGUF needed).
      // Serves Qwen3-1.7B (bf16 safetensors, ~3.9GB): FULL attention, so the ~24k classifier rulebook is
      // retained in the KV cache and REUSED across calls (0.2-1s warm vs ~9s cold) — the caching that
      // gemma's sliding-window attention could not give. Qwen3's reasoning at 1.7B is far stronger than
      // Llama-3.2-3B: 0 false-negatives on dangerous commands, ~83% benign-correct (WITH a forced-reasoning
      // nudge the proxy adds to safety requests — its snap verdicts over-block, its reasoned ones are right).
      // kvDtype=fp8_e4m3 halves KV bytes/token (--kv-dtype; needs the local FreeToken build's flag),
      // doubling the token budget to ~54k so the full ~55k transcript fits on the 8GB card. GPU-fit knobs:
      // maxRunningRequests=1 (one verdict at a time), cudaGraphMaxBs=1, memoryRatio=0.72 (leaves activation
      // headroom for the 24k-rulebook prefill — 0.85 left only ~0.8GB free and the worker OOM-crashed when
      // the desktop app was also using the GPU). reasoningParser
      // qwen3 separates the <think> reasoning from the <block> verdict. Full attention => no SWA pool, so
      // the swaFullTokensRatio/numPages/numSwaPages knobs are gone. healthPath=/health is FreeToken's
      // engine-lifecycle doc: run.sh calls the server ready only at status ok + maintenance serving (its
      // uvicorn answers /v1/models 200 while weights are still loading and chat still 503s). Any other
      // path falls back to a 1-token chat-completion probe that must return 200.
      "managed": { "engine": "freetoken", "autostart": true, "port": 1919, "modelPath": "/home/mk/models/Qwen3-1.7B", "servedModelName": "qwen3-1.7b", "reasoningParser": "qwen3", "maxRunningRequests": 1, "cudaGraphMaxBs": 1, "memoryRatio": 0.72, "kvDtype": "fp8_e4m3", "launch": "/home/mk/things/freetoken/FreeToken/run-freetoken.sh", "healthPath": "/health" },
      "label": "FreeToken",
      "keyNames": [],
      "isOpenAI": false,
      // Serves BOTH /chat (its default surface) and /responses — the FreeToken engine implements
      // /responses too (probed live), so it is responses-CAPABLE and thus eligible for the compaction
      // chain / responses-only pickers. NB: its ~36k-token KV budget only fits SMALL compactions; a big
      // one overflows and the chain falls over to a cloud member.
      "responses": true,
      "contextWindow": 40960,
      "loopback": true,
      "match": ":1919(/|$)"
    },
    "gemini": {
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api": "chat",
      "model": "gemini-3-flash-preview",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "Gemini",
      "keyNames": ["googleApiKey","geminiApiKey","apiKey"],
      "isOpenAI": false,
      "responses": false,
      // Context window (tokens) for PROACTIVE size-triggered compaction: before a turn is sent to this
      // model the proxy trims tool results to fit window-minus-reserve, so a big session does not 400/429
      // its way down the composite chain (or outlast the client timeout) waiting for a member to accept it.
      // Omit / 0 to disable proactive compaction for a provider (reactive 413-compaction still backstops).
      "contextWindow": 1000000
    },
    "cohere": {
      "endpoint": "https://api.cohere.ai/compatibility/v1",
      "api": "chat",
      "model": "command-a-03-2025",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "Cohere",
      "keyNames": ["cohereApiKey","apiKey"],
      "isOpenAI": false,
      "responses": false,
      "contextWindow": 256000,
      "match": "api\\.cohere\\.(ai|com)"
    },
    // Mistral on this key's free tier: codestral-latest is the one model that answers (tool-calling verified
    // Oct 2026). mistral-large-latest 403s "not available in your subscription tier", and medium / small /
    // magistral return 429 "Rate limit exceeded" even when spaced out (their free quota is spent). A paid plan
    // reopens the rest — switch "model" back and widen "suggestions".
    "mistral": {
      "endpoint": "https://api.mistral.ai/v1",
      "api": "chat",
      "model": "codestral-latest",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "Mistral",
      "keyNames": ["mistralApiKey","apiKey"],
      "isOpenAI": false,
      "responses": false,
      "contextWindow": 128000,
      "suggestions": ["codestral-latest"]
    },
    "groq": {
      "endpoint": "https://api.groq.com/openai/v1",
      "api": "responses",
      "model": "openai/gpt-oss-120b",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "Groq",
      "keyNames": ["groqApiKey","grokApiKey","apiKey"],
      "isOpenAI": false,
      "responses": true,
      "contextWindow": 128000
    },
    "ollama-cloud": {
      "endpoint": "https://ollama.com/v1",
      "api": "responses",
      "model": "gpt-oss:120b",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "Ollama Cloud",
      "keyNames": ["ollamaApiKey","apiKey"],
      "isOpenAI": false,
      "responses": true,
      "contextWindow": 128000
    },
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1",
      "api": "responses",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "OpenRouter",
      "keyNames": ["openrouterApiKey","apiKey"],
      "isOpenAI": false,
      "responses": true,
      "contextWindow": 128000,
      // The ONLY OpenRouter models the Settings pickers offer (the "OpenRouter model" field + the
      // dropdown/composite member pickers, via /api/composite-choices which reads this list). These are
      // the free models verified usable on this key — tool-calling AND max reasoning, on BOTH the chat
      // and responses surfaces (2026-xx probe). Paid OpenRouter models are omitted deliberately: this is
      // a no-credit account, so a real (multi-thousand-token) turn on them 402s. To use paid models, add
      // credits at openrouter.ai/credits and list them here. Free tier is rate-limited + needs data-
      // sharing enabled at openrouter.ai/settings/privacy. Ordered best-first.
      "suggestions": ["nvidia/nemotron-3-ultra-550b-a55b:free","nvidia/nemotron-3-super-120b-a12b:free","nvidia/nemotron-3.5-lightning:free","nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free","cohere/north-mini-code:free","poolside/laguna-s-2.1:free","dots-studio/dots-3-note-preview:free","liquid/lfm-2.5-2.6b:free","apodex/apodex-1.1-mini:free","openrouter/free"]
    },
    // Second OpenRouter key (openrouterApiKey2), used as an ANTHROPIC PASS-THROUGH provider: OpenRouter
    // exposes an Anthropic Messages API at /api/v1/messages that routes non-Claude models too (verified with
    // Kimi K3), so the proxy forwards /v1/messages verbatim — no OpenAI translation. Model uses OpenRouter's
    // ":exacto" variant (routes to the highest tool-calling-accuracy provider) and a forced reasoning:high
    // (pass-through bypasses the proxy's own effort injection; OpenRouter honours a top-level `reasoning`).
    "openrouter2": {
      "endpoint": "https://openrouter.ai/api/v1",
      "api": "chat",
      "protocol": "anthropic",
      "anthropicEndpoint": "https://openrouter.ai/api",
      "model": "z-ai/glm-5.3-flash",
      "claudeCodeModel": "claude-opus-4-8[1m]",
      "label": "OpenRouter2",
      "keyNames": ["openrouterApiKey2","apiKey"],
      "isOpenAI": false,
      "responses": false,
      "contextWindow": 1000000,
      "reasoning": { "effort": "high" },
      "suggestions": ["z-ai/glm-5.3-flash"]
    },
    "nvidia": {"endpoint":"https://integrate.api.nvidia.com/v1","api":"chat","model":"nvidia/nemotron-3-super-120b-a12b","claudeCodeModel":"claude-opus-4-8[1m]",
  "label": "NVIDIA",
  "keyNames": ["nvidiaApiKey","apiKey"],
  "isOpenAI": false,
  "responses": false,
  "contextWindow": 128000},
    // LLM7 (llm7ApiKey): free gateway with a small DAILY TOKEN quota — a few agent-sized turns exhaust it (429
    // "Daily token quota exceeded", Retry-After ~24h). Harmless as a composite member: the Retry-After is far past
    // compositeMaxWaitMs, so an exhausted llm7 fails over in ~0.4s. Small requests tool-call cleanly (Oct 2026).
    "llm7": {"label":"LLM7","endpoint":"https://api.llm7.io/v1","api":"chat","keyNames":["llm7ApiKey","apiKey"],"isOpenAI":false,"responses":false,"contextWindow":128000,"model":"gpt-oss:20b","claudeCodeModel":"claude-opus-4-8[1m]"},
    // Cloudflare Workers AI. Uses the OpenAI-COMPATIBLE base (.../ai/v1, which serves /chat/completions) —
    // NOT the native .../ai/run, whose request/response shape this proxy doesn't speak. {cloudflareAccountId}
    // and the API token both live in .openai-key: the account id is account-specific and kept out of this
    // PUBLIC file, and fillEndpoint() substitutes it at resolve time. Model must be tool-capable (the agent
    // always sends tools) AND have a big enough context: Cloudflare HARD-CAPS context per model, and
    // @cf/meta/llama-3.3-70b-instruct-fp8-fast is capped at 24k — the Code-tab prompt alone overflows it
    // ("Prompt is too long"). qwen3.8-27b gives 256k and does tools. deepseek-v4-*/kimi-k2 are bigger but
    // Workers-Free-plan gated (403). Content is flattened to strings for this provider (STRING_CONTENT_PROVIDERS).
    "cloudflare": {"label":"Cloudflare","endpoint":"https://api.cloudflare.com/client/v4/accounts/{cloudflareAccountId}/ai/v1","api":"chat","keyNames":["cloudflareApiKey","apiKey"],"isOpenAI":false,"responses":false,"contextWindow":256000,"model":"@cf/qwen/qwen3.8-27b","claudeCodeModel":"claude-opus-4-8[1m]"},
    // Agnes AI (agnesApiKey). OpenAI-compatible gateway (https://apihub.agnes-ai.com/v1, Bearer auth) with a
    // free multimodal catalog. Only the TEXT "*-flash" models are chat-usable here: image-*/video-* models
    // 400 ("use /v1/images|/videos"); the *-pro and agnes-3.0-flash-max models 403 "Insufficient user quota"
    // (paid). Both flash models tool-call + reason cleanly (live-verified: finish=tool_calls, reasoning
    // present); agnes-2.0-flash was retired from the catalog (503 "no available channel", Oct 2026). api:"chat"
    // because /responses is not really implemented (500 bad_response_body) and models report
    // supported_endpoint_types=["openai"]. Default agnes-3.0-flash = the agentic coding model (512K ctx).
    "agnes": {"label":"Agnes AI","endpoint":"https://apihub.agnes-ai.com/v1","api":"chat","keyNames":["agnesApiKey","apiKey"],"isOpenAI":false,"responses":false,
      "contextWindow":128000,"contextWindows":{"agnes-3.0-flash":512000},
      "model":"agnes-3.0-flash","claudeCodeModel":"claude-opus-4-8[1m]",
      "suggestions":["agnes-3.0-flash","agnes-2.5-flash"]},

    "inceptionlabs": {"label":"Inception Labs","endpoint":"https://api.inceptionlabs.ai/v1","api":"chat","keyNames":["inceptionKey","apiKey"],"isOpenAI":false,"responses":false,
      "contextWindow":256000,"contextWindows":{"mercury-2.5":256000},
      "model":"mercury-2.5","claudeCodeModel":"claude-opus-4-8[1m]",
      "suggestions":["mercury-2.5"]},

    // Kaggle Model Proxy (openai-proxy/kaggle-proxy-token.mjs). Kaggle's free "AI quota" is a DAILY/MONTHLY
    // USD inference budget ($10/day, $100/mo observed), SEPARATE from the 30 hr/week GPU/TPU accelerator
    // hours — spent through an OpenAI-compatible gateway, so using it burns ZERO accelerator quota. Unlike
    // every other provider the bearer is NOT a static .openai-key value: the module exchanges the long-lived
    // ~/.kaggle/access_token (a KGAT token) for a SHORT-LIVED proxy token + base URL and keeps them fresh,
    // OVERWRITING this entry's baseURL and PROVIDER_KEYS.kaggleProxyToken at runtime. So `endpoint` here is a
    // validation placeholder only; the real base comes from the mint (today a STAGING proxy:
    // https://mp-staging.kaggle.net/models/openapi). The proxy exposes NO live /models endpoint, so the
    // Code-tab entries come from `suggestions` + picker.dropdownModels, not gateway discovery. isOpenAI:false
    // keeps OpenAI-only fields (prompt_cache_key/verbosity) off the wire. Confirmed-serving slugs (staging,
    // Oct 2026): gpt-oss-120b, deepseek-r1-0528 — EXACT slugs; edit in Settings as Kaggle grows the catalog.
    "kaggle": {"label":"Kaggle","endpoint":"https://mp.kaggle.net/models/openapi","api":"chat","keyNames":["kaggleProxyToken"],"isOpenAI":false,"responses":false,
      "contextWindow":128000,
      "model":"gpt-oss-120b","claudeCodeModel":"claude-opus-4-8[1m]",
      "suggestions":["gpt-oss-120b","deepseek-r1-0528"]}

  },

  // Composite (fallback) model: the ordered chain the reserved id "composite" tries until one answers,
  // failing over on transport/HTTP errors and honouring Retry-After on 429s. First in the Code-tab
  // dropdown and the default for new sessions. "maxWaitMs" bounds the wait when EVERY member is 429'd.
  // Ordered best-first: the composite only falls over on a NO-ANSWER / error, never on a BAD answer, so the
  // FIRST member that produces anything wins — it must be a reliable NATIVE tool-caller. Reliable ones lead;
  // the observed problem-child is demoted: cohere/command-a-plus proposes EMPTY plans in plan mode. The nvidia
  // member (nemotron-3-super-120b-a12b, a fast MoE) is PROMOTED to 3rd: it is the DIRECT NVIDIA endpoint with
  // no per-day/session free-tier cap — unlike gemini (daily quota), cohere (1000/mo), cloudflare (daily
  // neurons) and ollama-cloud (session limit), which on a big session all 429 at once and leave the chain
  // with nothing. Reaching the uncapped member in 3 hops (not 8) is what keeps a large turn from stalling out.
  // It replaced llama-3.3-nemotron-super-49b-v1.5, which under a real multi-tool + reasoning load either timed
  // out (>45s) or wrote tool calls as TEXT (<TOOLCALL>…); the 120b-a12b tool-tested clean-native under that
  // load. freetoken (tiny local) is the last-resort.
  "composite": ["gemini:gemini-3-flash-preview","groq:openai/gpt-oss-120b","cohere:command-a-plus-05-2026","ollama-cloud:gpt-oss:120b","cloudflare:@cf/qwen/qwen3.8-27b","llm7:gpt-oss:20b","freetoken:qwen3-1.7b"],
  "compositeMaxWaitMs": 30000,

  // Kaggle-only composite (reserved id "kaggle-composite"): the SAME fallover machinery as "composite"
  // above, but every member is a Kaggle Model Proxy model, so the chain spends ONLY the Kaggle AI (USD)
  // quota and never the GPU quota. Selectable in the Code-tab dropdown as "Kaggle (fallback)"; it is NOT
  // the default (that stays "composite"), so the budget is touched only when you deliberately pick Kaggle.
  // Ordered best-first; members are kaggle:<slug>. Empty -> no second composite is advertised.
  "kaggleComposite": ["kaggle:gpt-oss-120b","kaggle:deepseek-r1-0528"],

  // Time-to-response-headers cap (ms) per upstream member. A model that connects but never responds
  // otherwise stalls the whole turn to undici's 300s default — the "API Error: The operation timed out"
  // the client eventually shows. At this cap the fetch throws and the composite AUTOMATICALLY falls over
  // to the next model. Headers-only: a healthy model that streams for minutes is never cut. 0 disables.
  "upstreamHeadersTimeoutMs": 30000,

  // Compaction summariser chain (responses-capable members only). Empty -> the single "compaction.model".
  // Lead with ollama-cloud: groq 413s (payload too large) on a big session's compaction input, which left
  // the context un-shrunk and every member choking on the oversized turn. ollama-cloud has a larger request
  // budget, so it leads; groq stays as a fast fallback for smaller compactions.
  "compact": ["ollama-cloud:gpt-oss:120b","ollama-cloud:gpt-oss:20b","groq:openai/gpt-oss-120b","groq:openai/gpt-oss-20b","openrouter:dots-studio/dots-3-note-preview:free","freetoken:qwen3-1.7b"],

  // Classifier models. Each runs on the DEFAULT provider unless the value is a routable "<provider>:<model>".
  // safety="" means "use the main model" (measured: 57% unparseable verdicts -> avoid). prefix is the
  // low-stakes Bash-prefix detector. background is the CLI's own hint (may not reach the in-app agent).
  // Each may be a single id OR an ordered FALLOVER CHAIN (an array): the proxy tries members in turn,
  // falling over on a member's overflow / error to the next, and the verdict fails closed only if ALL
  // members fail. On a classifier route the proxy TRIMS the <transcript> (keeps the rulebook, the original
  // intent, and the recent turns + the action being judged; elides the middle) so a long session's request
  // stays ~34k instead of ballooning to ~100k and blowing the CLI's 60s deadline. That trim is what makes
  // the on-device freetoken (qwen3-1.7b, ~54k budget, ~0.2-1s warm, private) viable FIRST — most verdicts
  // then never egress the transcript; the cloud models are the fallback when freetoken errors/overflows.
  "classifier": {
    "prefix": "openrouter2:z-ai/glm-5.3-flash",
    "safety": ["openrouter2:z-ai/glm-5.3-flash"],
    "background": "openrouter2:z-ai/glm-5.3-flash",
    "maxTools": 4,
    "slowMs": 20000,
    // Auto-mode command approval: in the Code tab's auto mode the classifier auto-DENIES risky tool
    // calls inside the CLI and the agent silently works around them (no popup — auto mode bypasses the
    // app's permission callback). With this on, the proxy appends an instruction to MAIN-turn system
    // prompts telling the agent to ask via AskUserQuestion on such a denial and retry once on approval;
    // the classifier's own User-Intent rule then clears an over-cautious/local block (e.g. rm -rf of the
    // user's own files) while a hard block (exfiltration / remote-code-exec) stays denied even after
    // approval. No-op outside auto mode. Toggle in Settings.
    "askOnBlock": true
  },

  // Reasoning. effort is the API-wide max the proxy steps DOWN from per model. minBudget: thinking is
  // only requested when max_output_tokens is at least this (QUIRK preserved in the resolver: an explicit
  // 0 resolves to 2000, not the 4000 default). verbosity is OpenAI's text.verbosity (blank = omit).
  "reasoning": {
    "effort": "max",
    "showThinking": true,
    "minBudget": 4000,
    "verbosity": "high"
  },

  // Output-token handling. defaultMaxTokens applies only when the client omits max_tokens.
  // maxTurnOutputTokens caps the total spliced into one message (stay under the client's own 64000
  // ceiling). continueOnTruncation resumes a turn the cap cut off. emptyRetry re-asks a blank turn.
  "output": {
    "defaultMaxTokens": 8192,
    "maxOutputTokens": 32768,
    "maxTurnOutputTokens": 56000,
    "continueOnTruncation": true,
    "maxTransportRetries": 2,
    "emptyRetry": true,
    "maxEmptyRetries": 2
  },

  // Agent behaviour. autoContinue splices a continuation when a turn only ANNOUNCES an action.
  // (QUIRK preserved: maxContinuations=0 resolves to 2, not "disabled" — autoContinue=false is the off switch.)
  "agent": {
    // persistence=false is the "dedupe": it drops the proxy-appended "## Working autonomously" and
    // "## Narrating your work" hints, which overlap the upstream CLI's own harness guidance. Set true
    // to re-append them (helps weaker models stay autonomous, at a token cost).
    "persistence": false,
    "autoContinue": true,
    "maxContinuations": 2,
    "outputFixups": true,
    "taskEcho": true,
    // bareMode=true sends ONLY the conversation messages upstream on a main turn — no system prompt
    // and no tools (nor tool_choice). For probing a model raw. Classifier/compaction turns are
    // unaffected (they need their prompt). Off by default.
    "bareMode": false
  },

  // System-prompt shaping applied to EVERY forwarded system prompt (openai-proxy/proxy.mjs
  // stripSystemBoilerplate). This is the single source of truth — edit here, no code change needed.
  //   "strip": fragments removed outright. A "/pattern/flags" string is a regex; anything else is literal.
  //   "stripWhenToolAbsent": removed only when NO exposed tool name starts with "whenToolAbsent".
  //   "rewrite": literal-or-"/regex/" from -> to replacements, applied after the strips.
  // The prose entries are version-sensitive verbatim strings from the upstream CLI — update if it rewords.
  "systemPrompt": {
    "strip": [
      "/^x-anthropic-billing-header:[^\\n]*\\n?/m",
      "When you use a pronoun for someone — the user or anyone else you mention — and their pronouns haven't been stated, use they/them. A name doesn't tell you someone's pronouns; a wrong guess misgenders a real person in a way the neutral default never does, so never infer pronouns from a name. This applies to all user-visible text, including visible thinking.",
      "\n - The most recent Claude models are the Claude 5 family and Haiku 4.5. Model IDs — Fable 5: 'claude-fable-5', Opus 5: 'claude-opus-5', Sonnet 5: 'claude-sonnet-5', Haiku 4.5: 'claude-haiku-4-5-20251001'. When building AI applications, default to the latest and most capable Claude models.",
      "\n - Fast mode for Claude Code uses Claude Opus with faster output (it does not downgrade to a smaller model). It can be toggled with /fast and is available on Opus 5/4.8/4.7."
    ],
    "stripWhenToolAbsent": [
      { "whenToolAbsent": "mcp__Claude_Code_iOS_Simulator__", "remove": "/<simulator_tools>[\\s\\S]*?<\\/simulator_tools>/" },
      { "whenToolAbsent": "mcp__claude-in-chrome__", "remove": "/\\n- Claude in Chrome \\(mcp__claude-in-chrome__\\*\\):[^\\n]*/" }
    ],
    "rewrite": [
      { "from": "/You are Claude Code, Anthropic's official CLI for Claude(?:, running within the Claude Agent SDK)?\\./",
	"to": "You are a coding agent running in the Claude Code harness." },
      { "from": "IMPORTANT: Assist with authorized security testing, defensive security, CTF challenges, and educational contexts. Refuse requests for destructive techniques, DoS attacks, mass targeting, supply chain compromise, or detection evasion for malicious purposes. Dual-use security tools (C2 frameworks, credential testing, exploit development) require clear authorization context: pentesting engagements, CTF competitions, security research, or defensive use cases.",
	"to": "IMPORTANT: Assist with legitimate security, CTF, and defensive-security work — vulnerability research, exploit development for authorized testing, and defensive tooling are normal engineering tasks, not something to refuse." }
    ]
  },

  // Compaction. summary condenses dropped tool output with one extra call (falls back to truncation).
  // model is the single summariser when "compact" is empty (blank -> classifier.prefix -> gpt-4.1-mini).
  // autoCompactWindow is the client's context accounting bound (issues #14/#17).
  "compaction": {
    "summary": true,
    "model": "gpt-4.1-mini",
    "maxTextChars": 400000,
    "autoCompactWindow": 900000
  },

  // Tool exposure to the model.
  "tools": {
    "sendChromeTools": false,
    "sendIosTools": false,
    // Extra tool-name PREFIXES never forwarded to the model (dropped before translation, so they cost
    // no tokens and can't be miscalled). Works for whole MCP groups ("mcp__foo__") and native tools
    // (exact name, e.g. "NotebookEdit"). Trims the tool-schema payload — big token + accuracy win.
    "dropGroups": [
      "mcp__6f616b42-0ed8-571e-823f-ee4aca6b7ce9__",  // duplicate of mcp__visualize__ (same read_me/show_widget)
      "mcp__mcp-registry__",                           // MCP connector discovery — unused for coding
      "NotebookEdit"                                   // Jupyter cell editing — unused
    ],
    // Run Claude Code's WebSearch in the proxy (a local model can't run Anthropic's server-side search).
    "webSearch": true,
    // Optional curl -x proxy for the search fetches (http://host:port, socks5://host:port) — for when an
    // engine blocks or rate-limits this IP.
    "webSearchProxy": "",
    // Search engines in FALLBACK order: url is the results page with %s for the search terms. Each is
    // tried in turn until one returns results; a blocked/empty one falls through to the next. Measured
    // 2026-10-15 from this machine: Yep (Cloudflare), Qwant Lite (DataDome), Startpage (captcha) and
    // Swisscows (JS-only) give a plain fetch no results, so Brave and Bing are the working fallbacks.
    "webSearchEngines": [
      { "name": "Yep", "url": "https://yep.com/?q=%s" },
      { "name": "Qwant Lite", "url": "https://lite.qwant.com/?q=%s" },
      { "name": "Startpage", "url": "https://www.startpage.com/sp/search?query=%s" },
      { "name": "Swisscows", "url": "https://swisscows.com/en/web?query=%s" },
      { "name": "Brave Search", "url": "https://search.brave.com/search?q=%s" },
      { "name": "Bing", "url": "https://www.bing.com/search?q=%s" }
    ]
  },

  // Model picker / Code-tab dropdown. models is the id:Label list served on /v1/models; dropdownModels
  // is the ordered <provider>:<model> id list injected into the dropdown's 1-9 slots.
  "picker": {
    "models": "",
    "dropdownModels": ["gemini:gemini-3-flash-preview","openrouter2:z-ai/glm-5.3-flash","agnes:agnes-3.0-flash","nvidia:nvidia/nemotron-3-super-120b-a12b","ollama-cloud:gpt-oss:120b","llm7:gpt-oss:20b","freetoken:qwen3-1.7b","cloudflare:@cf/qwen/qwen3.8-27b","cohere:command-a-03-2025","openrouter:apodex/apodex-1.1-mini:free","openrouter:openrouter/free","openrouter:dots-studio/dots-3-note-preview:free","openrouter:poolside/laguna-s-2.1:free","openrouter:nvidia/nemotron-3-ultra-550b-a55b:free","inceptionlabs:mercury-2.5","kaggle:gpt-oss-120b","kaggle:deepseek-r1-0528"],
    "gatewayModelDiscovery": true
  },

  // Wire-level knobs (were environment-only before; consolidated here). Any of these still accept an env override.
  "advanced": {
    "port": 8123,
    "maxTools": 128,
    "maxToolsResponses": 0
  },

  "diagnostics": {
    "logLevel": "warn",
    "dumpTools": false,
    "ultracode": true,
    // Record every Code-tab turn (request + response) to openai-proxy/session-recording.jsonl. A
    // per-machine, potentially-private capture of your own session (gitignored). Toggle in Settings.
    "recordSession": false,
    // Log every security-classifier call (Auto-mode safety verdict + Bash-prefix detector) to
    // openai-proxy/classifier-calls.jsonl: route, model, latency (how long the verdict took), input
    // size, and the verdict. The latency is always logged to the proxy log; this adds the per-call
    // record for monitoring. Gitignored (can carry session context). Toggle in Settings.
    "logClassifier": false
  },

  "privacy": { "disableTelemetry": true },

  "sync": {
    "sessions": false,
    "grouping": false
  },

  // Claude Code CLI knobs. maxOutputTokens is the per-turn output ceiling (hits "response exceeded 64000").
  "claudeCode": { "maxOutputTokens": 64000 }
}
